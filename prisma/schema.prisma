// Dayflow HRMS — Prisma Schema
// PostgreSQL via Neon (serverless)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}


// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  EMPLOYEE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
}

enum EmploymentStatus {
  ACTIVE
  INACTIVE
  ON_NOTICE
  TERMINATED
}

// ─── Company (Tenant) ────────────────────────────────────────────────────────

model Company {
  id        String   @id @default(cuid())
  name      String
  initials  String   // e.g. "DF" from "Dayflow"
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  users        User[]
  employees    Employee[]
  leaveTypes   LeaveType[]
  activityLogs ActivityLog[]

  @@map("company")
}

// ─── User (Auth) ──────────────────────────────────────────────────────────────

model User {
  id                 String   @id @default(cuid())
  employeeId         String   @unique @map("employee_id")
  email              String   @unique
  passwordHash       String   @map("password_hash")
  role               Role     @default(EMPLOYEE)
  isActive           Boolean  @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  companyId          String?  @map("company_id")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  // Relations
  company        Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee       Employee?
  reviewedLeaves LeaveRequest[] @relation("ReviewedLeaves")
  activityLogs   ActivityLog[]

  @@index([companyId])
  @@index([email])
  @@index([employeeId])
  @@map("users")
}

// ─── Employee Profile ─────────────────────────────────────────────────────────

model Employee {
  id               String           @id @default(cuid())
  userId           String           @unique @map("user_id")
  companyId        String?          @map("company_id")
  firstName        String           @map("first_name")
  lastName         String           @map("last_name")
  phone            String?
  address          String?
  city             String?
  state            String?
  postalCode       String?          @map("postal_code")
  designation      String?
  department       String?
  joiningDate      DateTime?        @map("joining_date") @db.Date
  employmentStatus EmploymentStatus @default(ACTIVE) @map("employment_status")
  profileImage     String?          @map("profile_image")
  manager          String?
  location         String?
  // Resume tab
  about            String?          @db.Text
  whatILoveAboutMyJob String?       @map("what_i_love_about_my_job") @db.Text
  interestsAndHobbies String?       @map("interests_and_hobbies") @db.Text
  skills           String[]         @default([])
  certifications   String[]         @default([])
  // Private Info tab
  dateOfBirth      DateTime?        @map("date_of_birth") @db.Date
  nationality      String?
  personalEmail    String?          @map("personal_email")
  gender           String?
  maritalStatus    String?          @map("marital_status")
  bankAccountNumber String?         @map("bank_account_number")
  bankName         String?          @map("bank_name")
  bankIfsc         String?          @map("bank_ifsc")
  panNumber        String?          @map("pan_number")
  uanNumber        String?          @map("uan_number")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  company         Company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  attendances     Attendance[]
  leaveRequests   LeaveRequest[]
  salaryStructure SalaryStructure?
  documents       EmployeeDocument[]

  @@index([userId])
  @@index([companyId])
  @@index([department])
  @@map("employees")
}


// ─── Employee Documents ───────────────────────────────────────────────────────

model EmployeeDocument {
  id           String   @id @default(cuid())
  employeeId   String   @map("employee_id")
  documentType String   @map("document_type") // Aadhaar, PAN, Resume, etc.
  documentName String   @map("document_name")
  documentUrl  String   @map("document_url")
  createdAt    DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

// ─── Attendance ───────────────────────────────────────────────────────────────

model Attendance {
  id             String           @id @default(cuid())
  employeeId     String           @map("employee_id")
  attendanceDate DateTime         @map("attendance_date") @db.Date
  checkIn        DateTime?        @map("check_in")
  checkOut       DateTime?        @map("check_out")
  workedMinutes  Int              @default(0) @map("worked_minutes")
  status         AttendanceStatus @default(PRESENT)
  createdAt      DateTime         @default(now()) @map("created_at")
  updatedAt      DateTime         @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, attendanceDate])
  @@index([employeeId])
  @@index([attendanceDate])
  @@map("attendance")
}

// ─── Leave Types ──────────────────────────────────────────────────────────────

model LeaveType {
  id          String  @id @default(cuid())
  companyId   String? @map("company_id")
  name        String
  description String?
  isPaid      Boolean @default(true) @map("is_paid")
  annualLimit Int?    @map("annual_limit") // null = unlimited
  isActive    Boolean @default(true) @map("is_active")

  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  leaveRequests LeaveRequest[]

  @@index([companyId])
  @@map("leave_types")
}

// ─── Leave Requests ───────────────────────────────────────────────────────────

model LeaveRequest {
  id          String      @id @default(cuid())
  employeeId  String      @map("employee_id")
  leaveTypeId String      @map("leave_type_id")
  startDate   DateTime    @map("start_date") @db.Date
  endDate     DateTime    @map("end_date") @db.Date
  totalDays   Decimal     @map("total_days") @db.Decimal(4, 1)
  reason      String
  status      LeaveStatus @default(PENDING)
  reviewedBy  String?     @map("reviewed_by")
  reviewedAt  DateTime?   @map("reviewed_at")
  adminComment String?    @map("admin_comment")
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id])
  reviewer  User?     @relation("ReviewedLeaves", fields: [reviewedBy], references: [id])

  @@index([employeeId])
  @@index([status])
  @@index([startDate])
  @@map("leave_requests")
}

// ─── Salary Structure ─────────────────────────────────────────────────────────

model SalaryStructure {
  id                    String   @id @default(cuid())
  employeeId            String   @unique @map("employee_id")
  monthlyWage           Decimal  @default(0) @map("monthly_wage") @db.Decimal(12, 2)
  yearlyWage            Decimal  @default(0) @map("yearly_wage") @db.Decimal(12, 2)
  workingDaysPerWeek    Int      @default(5) @map("working_days_per_week")
  workingHoursPerDay    Decimal  @default(8) @map("working_hours_per_day") @db.Decimal(4, 1)
  breakTimeHours        Decimal  @default(1) @map("break_time_hours") @db.Decimal(4, 1)
  basicSalary           Decimal  @default(0) @map("basic_salary") @db.Decimal(12, 2)
  hra                   Decimal  @default(0) @db.Decimal(12, 2)
  standardAllowance     Decimal  @default(0) @map("standard_allowance") @db.Decimal(12, 2)
  performanceBonus      Decimal  @default(0) @map("performance_bonus") @db.Decimal(12, 2)
  leaveTravelAllowance  Decimal  @default(0) @map("leave_travel_allowance") @db.Decimal(12, 2)
  fixedAllowance        Decimal  @default(0) @map("fixed_allowance") @db.Decimal(12, 2)
  employeePf            Decimal  @default(0) @map("employee_pf") @db.Decimal(12, 2)
  employerPf            Decimal  @default(0) @map("employer_pf") @db.Decimal(12, 2)
  professionalTax       Decimal  @default(200) @map("professional_tax") @db.Decimal(12, 2)
  allowances            Decimal  @default(0) @db.Decimal(12, 2)
  deductions            Decimal  @default(0) @db.Decimal(12, 2)
  pf                    Decimal  @default(0) @db.Decimal(12, 2)
  tax                   Decimal  @default(0) @db.Decimal(12, 2)
  grossSalary           Decimal  @default(0) @map("gross_salary") @db.Decimal(12, 2)
  netSalary             Decimal  @default(0) @map("net_salary") @db.Decimal(12, 2)
  effectiveFrom         DateTime @default(now()) @map("effective_from") @db.Date
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([employeeId])
  @@map("salary_structures")
}


// ─── Activity Logs ────────────────────────────────────────────────────────────

model ActivityLog {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  companyId   String?  @map("company_id")
  action      String   // e.g. EMPLOYEE_CHECKED_IN
  entityType  String?  @map("entity_type") // attendance, leave, employee, etc.
  entityId    String?  @map("entity_id")
  description String
  createdAt   DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
  @@map("activity_logs")
}
